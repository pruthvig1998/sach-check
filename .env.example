# Optional. Sach runs without any of these in "limited mode" (clear PIB debunks only, mostly UNVERIFIED).
# ---- AI judge: tried in this order; if one is out of quota the next answers automatically ----
# GEMINI_API_KEY=            # Google AI Studio free tier. Several keys (different Google accounts) may be comma-separated: key1,key2
# GEMINI_API_KEY_2=          # (alternative way to add a second key)
# SACH_GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest
# GROQ_API_KEY=              # free tier: console.groq.com   (override models with SACH_GROQ_MODELS)
# OPENROUTER_API_KEY=        # free ":free" models: openrouter.ai   (SACH_OPENROUTER_MODELS)
# MISTRAL_API_KEY=           # free "experiment" tier: console.mistral.ai   (SACH_MISTRAL_MODELS)
# ANTHROPIC_API_KEY=         # optional, paid, last resort (SACH_MODEL)
# Verify keys and model names with:  python scripts/check_llm.py
# ---- live search ----
# BRAVE_API_KEY=             # Brave Search (tried first)
# TAVILY_API_KEY=            # Tavily: failover when Brave is out of credits (402) or down. Free plan: 1,000 credits a month, no card
#                            # (https://docs.tavily.com/documentation/api-credits); one basic search = 1 credit
# SACH_SEARCH_ORDER=brave,tavily   # e.g. tavily,brave to try Tavily first
# A provider that answers 402/401/403 is skipped for 6 hours; 429 for its Retry-After. Verify keys: python scripts/check_search.py
# If no provider answers, the result says so (search_status down/partial) and is not cached.
SACH_CACHE_DIR=cache
SACH_LEDGER=data/ledger.json
# ---- optional tip jar (UPI). Leave unset to hide it. Never commit your real UPI ID: set it as an environment variable. ----
# SACH_UPI_ID=yourname@yourbank     # your UPI address (VPA); shows tip buttons + QR that pay straight to it
# SACH_UPI_NAME=Sach                # name shown in the payer's UPI app
# SACH_UPI_ID_ALT=other@handle   # optional second UPI address for the SAME bank account; payers can switch to it if the first code fails
# ---- optional tip jar, route 1: card/UPI checkout via Razorpay (test keys rzp_test_..., live keys rzp_live_...) ----
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=              # never commit; server side only
# RAZORPAY_WEBHOOK_SECRET=          # a secret you choose; enter the same value in Razorpay > Webhooks (URL: https://<site>/?api=rzp-webhook)
# ---- optional: show UPI app buttons. ONLY for a verified MERCHANT UPI ID (NPCI blocks link payments to personal IDs) ----
# SACH_UPI_MERCHANT=1
# ---- optional: contact email shown on the Contact/Privacy/Refund pages (otherwise GitHub issues is shown) ----
# SACH_CONTACT_EMAIL=
