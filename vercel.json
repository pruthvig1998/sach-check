{
  "rewrites": [
    {
      "source": "/impact",
      "destination": "/api/index?view=impact"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?view=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?view=sitemap"
    },
    {
      "source": "/claimreview.json",
      "destination": "/api/index?view=claimreview"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{sach,data}/**"
    }
  },
  "regions": [
    "bom1"
  ]
}